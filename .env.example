# Supabase: required for Storefy login and workspace sync.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side only: required for secure Netlify token storage and publishing.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
NETLIFY_TOKEN_ENCRYPTION_KEY="YOUR_32_BYTE_BASE64_KEY"

# Comma-separated e-mails that can manage invitation codes.
STOREFY_ADMIN_EMAILS="admin@storefy.com"

# Product import (server-side only). Use one key or a comma-separated list of paid keys.
# The importer tries cheaper ScrapingBee layers first and uses stealth only as a last resort.
SCRAPINGBEE_API_KEY="YOUR_SCRAPINGBEE_API_KEY"
SCRAPINGBEE_API_KEYS="KEY_1,KEY_2,KEY_3"
SCRAPINGBEE_IMPORT_MODE="fast"
